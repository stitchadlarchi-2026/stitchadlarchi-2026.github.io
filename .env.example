# Copy to .env and fill in. .env is gitignored and never leaves this box.
#
#   cp .env.example .env
#   ./deploy/provision-tunnel.sh      # writes CLOUDFLARE_TUNNEL_TOKEN for you

# Cloudflare named tunnel token for the `stitch-exhibition` tunnel.
# Created by deploy/provision-tunnel.sh against Bijin's own Cloudflare account.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback port for checking the site on the box itself, without Cloudflare.
WEB_PORT=127.0.0.1:8094
