# Copy to .env and fill in. .env is gitignored and never leaves this box.
#
#   cp .env.example .env
#   ./deploy/provision-tunnel.sh      # writes CLOUDFLARE_TUNNEL_TOKEN for you

# Cloudflare named tunnel token for the `stitch-exhibition` tunnel.
# Created by deploy/provision-tunnel.sh against Bijin's own Cloudflare account.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback port for checking the site on the box itself, without Cloudflare.
WEB_PORT=127.0.0.1:8094

# Loopback port the host metrics collector reads the usage counters from.
USAGE_PORT=127.0.0.1:9094

# Password for the committee's download of exhibition submissions, at
# https://stitchexhibition.com/_s/export (any username). Long and random:
#   openssl rand -base64 24
# Left empty, the download is switched off; the form still takes submissions.
SUBMISSIONS_KEY=

# Cloudflare Turnstile secret for the exhibition form (widget "STITCH exhibition
# form" on Bijin's account). Required: compose will not start without it.
TURNSTILE_SECRET=
